# EPIOSO Brain is local-only by default.
BRAIN_HOST=127.0.0.1
BRAIN_WEB_PORT=3100
BRAIN_API_PORT=4000
BRAIN_WORKSPACE_ROOT=D:/Users/zakio/Desktop/Work/Epioso
BRAIN_OBJECT_STORAGE_PATH=./local-object-storage
BRAIN_GENERATED_ASSETS_PATH=./generated-assets
BRAIN_REQUIRE_APPROVALS=true
BRAIN_ALLOW_PUBLIC_DEPLOY=false

# Local data services. Safe placeholders only; override in private .env if needed.
POSTGRES_BIND_HOST=127.0.0.1
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=epioso_brain_local
POSTGRES_USER=epioso_brain_local
POSTGRES_PASSWORD=epioso_brain_local_password
DATABASE_URL=postgresql://epioso_brain_local:epioso_brain_local_password@127.0.0.1:5432/epioso_brain_local?schema=public
BRAIN_DATABASE_URL=postgresql://epioso_brain_local:epioso_brain_local_password@127.0.0.1:5432/epioso_brain_local?schema=public

REDIS_BIND_HOST=127.0.0.1
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379

# Optional local adapter placeholders. Replace only in your private .env file.
HERMES_BRIDGE_URL=http://127.0.0.1:9119
HERMES_API_KEY=replace-with-local-placeholder
N8N_BASE_URL=http://127.0.0.1:5678
N8N_API_KEY=replace-with-local-placeholder
GITHUB_TOKEN=replace-with-local-placeholder
