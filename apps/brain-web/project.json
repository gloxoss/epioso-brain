{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "brain-web",
  "projectType": "application",
  "sourceRoot": "apps/brain-web/src",
  "tags": [
    "scope:web",
    "type:app"
  ],
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "next dev apps/brain-web"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/dist/apps/brain-web"
      ],
      "options": {
        "command": "next build apps/brain-web"
      }
    },
    "type-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p apps/brain-web/tsconfig.json --noEmit"
      }
    }
  }
}
